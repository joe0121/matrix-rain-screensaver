#!/usr/bin/env python3
"""Settings TUI for the Matrix screensaver (Omarchy / Hyprland).

- Idle time: writes idle.screensaver (seconds) in ~/.config/omarchy/shell.json.
  The Omarchy shell hot-reloads that file, so it applies immediately.
- Everything else (Matrix mode, speed, characters, colour) lives in
  ~/.config/matrix-screensaver/config, read by matrix-rain at start.

Every change is saved immediately and the menu stays open; choose Quit to leave.
"""
import json, os, re, shutil, subprocess, sys

HOME = os.path.expanduser("~")
SHELL_JSON = os.path.join(HOME, ".config/omarchy/shell.json")
CONF_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME", HOME + "/.config"), "matrix-screensaver")
CONF = os.path.join(CONF_DIR, "config")
DEFAULT_SS, DEFAULT_LOCK, LOCK_GAP = 150, 300, 150
HAVE_GUM = shutil.which("gum") is not None


def gum(*args, capture=True):
    r = subprocess.run(["gum", *args], stdout=subprocess.PIPE if capture else None, text=True)
    return r.stdout.strip() if r.returncode == 0 else None


def choose(header, options):
    if HAVE_GUM:
        return gum("choose", "--header", header, *options)
    print(header)
    for i, o in enumerate(options, 1):
        print(f"  {i}) {o}")
    try:
        return options[int(input("> ")) - 1]
    except (ValueError, IndexError, EOFError):
        return None


def ask(prompt, value=""):
    if HAVE_GUM:
        return gum("input", "--prompt", prompt + " ", "--value", value)
    try:
        return input(f"{prompt} [{value}] ").strip() or value
    except EOFError:
        return None


def say(msg):
    if HAVE_GUM:
        gum("style", "--foreground", "46", msg, capture=False)
    else:
        print(msg)


def read_shell():
    try:
        with open(SHELL_JSON) as f:
            return json.load(f)
    except FileNotFoundError:
        return {}


def write_shell(cfg):
    os.makedirs(os.path.dirname(SHELL_JSON), exist_ok=True)
    bak = f"{SHELL_JSON}.bak.matrix"
    if os.path.exists(SHELL_JSON) and not os.path.exists(bak):  # keep the original, not the latest
        shutil.copy2(SHELL_JSON, bak)
    tmp = SHELL_JSON + ".tmp"
    with open(tmp, "w") as f:
        json.dump(cfg, f, indent=2, ensure_ascii=False)
        f.write("\n")
    os.replace(tmp, SHELL_JSON)


def get_idle():
    idle = read_shell().get("idle", {})
    return int(idle.get("screensaver", DEFAULT_SS)), int(idle.get("lock", DEFAULT_LOCK))


def set_lock(sec):
    """Set idle.lock (seconds). Returns (ok, screensaver, lock)."""
    cfg = read_shell()
    idle = cfg.setdefault("idle", {})
    ss = int(idle.get("screensaver", DEFAULT_SS))
    if sec <= ss:
        return False, ss, int(idle.get("lock", DEFAULT_LOCK))
    idle["lock"] = sec
    write_shell(cfg)
    return True, ss, sec


def set_idle(ss):
    cfg = read_shell()
    idle = cfg.setdefault("idle", {})
    lock = int(idle.get("lock", DEFAULT_LOCK))
    idle["screensaver"] = ss
    if lock <= ss:  # lock must come after the screensaver
        idle["lock"] = ss + LOCK_GAP
    write_shell(cfg)
    return idle["screensaver"], idle["lock"]


DEFAULTS = {"matrix": "on", "speed": "5", "charset": "katakana", "custom": "", "color": "green"}

CHARSETS = {
    "Katakana (classic)": "katakana",
    "Latin letters and digits": "latin",
    "Binary (0 and 1)": "binary",
    "Hex": "hex",
    "Klingon (pIqaD)": "klingon",
    "The word OMARCHY": "omarchy",
    "Spell my own text": "text",
    "Random characters from my own string": "custom",
}
COLORS = ["green", "cyan", "blue", "purple", "pink", "red", "amber", "white", "rainbow"]


def load():
    cfg = dict(DEFAULTS)
    try:
        with open(CONF) as f:
            for line in f:
                if "=" in line:
                    k, v = line.rstrip("\n").split("=", 1)
                    cfg[k.strip()] = v.strip()
    except FileNotFoundError:
        pass
    return cfg


def save(cfg):
    os.makedirs(CONF_DIR, exist_ok=True)
    tmp = CONF + ".tmp"
    with open(tmp, "w") as f:
        for k in DEFAULTS:
            f.write(f"{k}={cfg.get(k, DEFAULTS[k]).replace(chr(10), ' ')}\n")
    os.replace(tmp, CONF)


def fmt(sec):
    m, s = divmod(sec, 60)
    return f"{m}m {s}s" if m and s else (f"{m}m" if m else f"{s}s")


def parse_minutes(text):
    try:
        sec = round(float(text.strip().rstrip("m").strip()) * 60)
    except (ValueError, AttributeError):
        return None
    return sec if 10 <= sec <= 24 * 3600 else None


def notify(msg):
    if shutil.which("notify-send"):
        subprocess.Popen(["notify-send", "-a", "Matrix Screensaver", "Matrix Screensaver", msg],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


LAST = [""]


def status(msg):
    """Remember the result of the last change so the menu can show it."""
    LAST[0] = msg


def piqad_installed():
    r = subprocess.run(["fc-list", ":charset=f8d0", "family"], capture_output=True, text=True)
    return bool(r.stdout.strip())


def charset_label(cfg):
    name = cfg["charset"]
    lab = next((k for k, v in CHARSETS.items() if v == name), name)
    if name in ("text", "custom"):
        lab += f' "{cfg["custom"]}"'
    return lab


def one_round():
    """Show the menu once. Returns False when the user wants to leave."""
    cfg = load()
    ss, lock = get_idle()
    os.system("clear")
    print("Matrix Screensaver settings\n")
    print(f"  Matrix mode : {'ON' if cfg['matrix'] == 'on' else 'off (stock Omarchy effects)'}")
    print(f"  Starts after: {fmt(ss)} idle (locks at {fmt(lock)})")
    print(f"  Speed       : {cfg['speed']}/10")
    print(f"  Characters  : {charset_label(cfg)}")
    print(f"  Colour      : {cfg['color']}\n")
    if LAST[0]:
        say(("  \u2717 " if "not changed" in LAST[0] else "  \u2713 ") + LAST[0] + "\n")

    pick = choose("What do you want to change?", [
        "Idle time before screensaver",
        "Idle time before lock screen",
        "Rain speed",
        "Characters",
        "Colour",
        "Toggle Matrix mode",
        "Preview now",
        "Quit",
    ])
    if pick in (None, "Quit"):
        return False

    if pick == "Idle time before lock screen":
        v = ask("Minutes of inactivity before locking (e.g. 10):", f"{lock / 60:g}")
        if v is None:
            return True
        sec = parse_minutes(v)
        if sec is None:
            status("Lock time not changed: enter 0.17 (10s) to 1440 minutes.")
            return True
        ok, ss, lock = set_lock(sec)
        status(f"Locks after {fmt(lock)} idle." if ok else
               f"Lock time not changed: it must be later than the screensaver ({fmt(ss)}).")
        return True

    if pick.startswith("Idle"):
        v = ask("Minutes of inactivity (e.g. 2.5):", f"{ss / 60:g}")
        if v is None:
            return True
        sec = parse_minutes(v)
        if sec is None:
            status("Idle time not changed: enter 0.17 (10s) to 1440 minutes.")
            return True
        ss, lock = set_idle(sec)
        status(f"Starts after {fmt(ss)} idle, locks after {fmt(lock)}.")
        return True

    if pick.startswith("Rain"):
        v = choose("Speed (1 = slow, 10 = fast)", [str(i) for i in range(1, 11)]) if not HAVE_GUM else \
            gum("choose", "--header", "Speed (1 = slow, 10 = fast)", "--selected", cfg["speed"],
                *[str(i) for i in range(1, 11)])
        if v:
            cfg["speed"] = v
            save(cfg)
            status(f"Speed set to {v}/10.")
        return True

    if pick == "Characters":
        v = choose("Character set", list(CHARSETS))
        if not v:
            return True
        name = CHARSETS[v]
        if name in ("text", "custom"):
            prompt = "Text to spell out:" if name == "text" else "Characters to use:"
            t = ask(prompt, cfg["custom"])
            if not t or not t.strip():
                return True
            cfg["custom"] = t.strip()
        cfg["charset"] = name
        save(cfg)
        extra = ""
        if name == "klingon" and not piqad_installed():
            extra = " pIqaD font not installed: rerun ./install.sh --fonts (using Latin letters for now)."
        status(f"Characters: {charset_label(cfg)}.{extra}")
        return True

    if pick == "Colour":
        v = choose("Colour", COLORS + ["custom hex (#rrggbb)"])
        if not v:
            return True
        if v.startswith("custom"):
            v = (ask("Hex colour:", "#00ff41") or "").strip()
            if not re.fullmatch(r"#[0-9a-fA-F]{6}", v):
                status("Colour not changed: use the form #rrggbb.")
                return True
        cfg["color"] = v.lower()
        save(cfg)
        status(f"Colour: {cfg['color']}.")
        return True

    if pick.startswith("Toggle"):
        cfg["matrix"] = "off" if cfg["matrix"] == "on" else "on"
        save(cfg)
        status(f"Matrix mode {cfg['matrix']}.")
        return True

    if pick.startswith("Preview"):
        subprocess.Popen(["omarchy-launch-screensaver", "force"], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return False  # the saver takes over the screen; close the menu
    return True


def main():
    while one_round():
        pass


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
